          "TextPosition": "above",
          "ShowValue": true,
          "ShowStatements": true,
          "StartingValue": -1,
          "NumScalePoints": 3,
          "MobileFirst": false
        },
        "QuestionDescription": "Q11-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_2dd53f36e40e471ed8a452b1",
