    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID75",
      "SecondaryAttribute": "Q55-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_f1f38369922e35f0adf8d32f",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>2.3 dehumanising attacks &amp; overt sexual objectification</strong> – Dehumanization, animalization, sexual objectification, or reduction of women to sexual or body objects.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: References\n\nInter-Parliamentary Union (2016), ‘Sexism, harassment and violence against women parliamentarians’, Issues Brief, October, Geneva (https://www.ipu.org/resources/publications/issue-briefs/2016-10/sexism-harassment-and-violence-against-women-parliamentarians).\n\nIrish Department of Justice and Equality (2017), National Strategy for Women and Girls 2017–2020: Creating a better society for all, Dublin (https://www.gov.ie/pdf/?file=https://assets.gov.ie/95975/bd524a60-e19f-44e8-80ce-9cdc58853403.pdf#page=null).\nReferences</div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q55-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_f1f38369922e35f0adf8d32f",
