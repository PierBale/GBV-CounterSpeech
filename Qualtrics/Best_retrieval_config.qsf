    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID143",
      "SecondaryAttribute": "Q126-bge-m3__qwen3-reranker-8b-chunk_c8cd55406cc196d341ce8bc5",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>4.2 supporting systemic discrimination against women as a group</strong> – Support for systemic discrimination, restriction of rights, or exclusion of women as a group.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 1.2. Defining cyber violence and hate speech online against women > 1.2.1. UN, EU and national definitions\n\n<sup>5</sup> CEDAW (2017), “General recommendation No. 35 on gender-based violence against women, updating general recommendation No. 19”, available at https://tbinternet.ohchr.org/Treaties/CEDAW/Shared%20Documents/1_Global/CEDAW_C_GC_35_8267_E.pdf\n\n11\n\nPolicy Department for Citizens' Rights and Constitutional Affairs\n\nmail accounts, mobile phones and other electronic devices, with a view to discrediting them and/or inciting other violations and abuses against them, are a growing concern and a manifestation of systemic gender-based discrimination, requiring effective responses compliant with human rights”. <sup>6</sup></div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q126-bge-m3__qwen3-reranker-8b-chunk_c8cd55406cc196d341ce8bc5",
        "QuestionID": "QID143",
        "QuestionType": "Slider",
        "Selector": "NumberScale",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "TextPosition": "above",
          "ShowValue": true,
