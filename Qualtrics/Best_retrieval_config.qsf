    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID145",
      "SecondaryAttribute": "Q128-qwen3-embedding-8b__qwen3-reranker-8b-chunk_200bfa6e26190fabf44a651d",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>4.2 supporting systemic discrimination against women as a group</strong> – Support for systemic discrimination, restriction of rights, or exclusion of women as a group.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 4 Legal and policy frameworks > 4.1 International legal and policy framework\n\nThe United Nations (UN) has directly recognised gender-based cyber violence in several\nresolutions, strategies recommendations and reports. In the UN General Assembly resolution on\nprotecting women human rights defenders, the General Assembly lists the types of cyber violence\nand information-technology-related violations that women could face. These include online\nharassment, cyberstalking, violation of privacy, censorship and the hacking of e-mail accounts,\nmobile phones and other electronic devices, with a view to discrediting them and/or inciting other\nviolations and abuses against them. The General Assembly states that these types of violations are\na growing concern and can be a manifestation of systemic gender-based discrimination.<sup>173</sup></div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q128-qwen3-embedding-8b__qwen3-reranker-8b-chunk_200bfa6e26190fabf44a651d",
        "QuestionID": "QID145",
        "QuestionType": "Slider",
