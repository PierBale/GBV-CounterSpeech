    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID139",
      "SecondaryAttribute": "Q122-bge-m3__qwen3-reranker-8b-chunk_3a434954926dd52770500d50",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>4.2 supporting systemic discrimination against women as a group</strong> – Support for systemic discrimination, restriction of rights, or exclusion of women as a group.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 4. Towards common definitions of cyber violence against women and girls > Proposed definition\n\nOnline gender-based hate speech is defined as content posted and shared through ICT means that:\n\nis hateful towards women and/or girls because of their gender, or because of a combination of gender and other factors (e.g. race, age, disability, sexuality, ethnicity, nationality, religion or profession); and/or\n\nspreads, incites, promotes or justifies hatred based on gender, or because of a combi- nation of gender and other factors (e.g. race, age, disability, sexuality, ethnicity, nationality, religion or profession).</div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q122-bge-m3__qwen3-reranker-8b-chunk_3a434954926dd52770500d50",
