    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID31",
      "SecondaryAttribute": "Q2-bge-m3__qwen3-reranker-8b-chunk_1713bcff2114a70bef1ace47",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>1.1 threats of harm</strong> – Direct or indirect threats of harm, violence, punishment, or intimidation against women or gendered subjects.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 2. SOCIETAL CONTEXT AND ROOT CAUSES OF CYBER VIOLENCE AND HATE SPEECH ONLINE AGAINST WOMEN > 2.3. The architecture of cyber spaces and women’s victimisation > 2.3.3. Mob mentality\n\nGender trolling attacks are precipitated by women asserting their opinions online;\n\nThey feature graphic sexualised and gender-based insults;\n\nThey include rape and death threats — often credible ones — and frequently involve real-life targeting, which adds to the credibility of the threats;\n\nThey cross multiple social media or online platforms;\n\nThey occur at unusually high levels of intensity and frequency (numerous threats or messages per day or even per hour);\n\nThey are perpetuated for an unusual duration (months or even years);\n\nThey involve many attackers in a concerted and often coordinated campaign.</div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q2-bge-m3__qwen3-reranker-8b-chunk_1713bcff2114a70bef1ace47",
        "QuestionID": "QID31",
        "QuestionType": "Slider",
        "Selector": "NumberScale",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "TextPosition": "above",
          "ShowValue": true,
          "ShowStatements": true,
          "StartingValue": -1,
          "NumScalePoints": 3,
          "MobileFirst": false
        },
        "QuestionDescription": "Q2-bge-m3__qwen3-reranker-8b-chunk_1713bcff2114a70bef1ace47",
