    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID32",
      "SecondaryAttribute": "Q3-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_00044e8dca3c44a18dde8020",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>1.1 threats of harm</strong> – Direct or indirect threats of harm, violence, punishment, or intimidation against women or gendered subjects.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: REFERENCES\n\nFRA. (2014). Violence against women: an EU-wide survey – Main results. Luxembourg: Publications Office of the European Union, p. 104.\n\nFRA. (2017). <u>Challenges to women’s human rights in the EU: Gender discrimination, sexist hate speech</u> <u>and gender-based violence against women and girls</u>. FRA.\n\nFox, J., Cruz, C., & Lee., J. Y. (2015). <u>Perpetuating online sexism offline: Anonymity, interactivity, and</u> the effects of sexist hashtags on social media. Computers in Human Behavior. 52.</div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q3-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_00044e8dca3c44a18dde8020",
        "QuestionID": "QID32",
        "QuestionType": "Slider",
        "Selector": "NumberScale",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText",
          "TextPosition": "above",
          "ShowValue": true,
          "ShowStatements": true,
          "StartingValue": -1,
          "NumScalePoints": 3,
          "MobileFirst": false
        },
        "QuestionDescription": "Q3-qwen3-embedding-8b__bge-reranker-v2-m3-chunk_00044e8dca3c44a18dde8020",
        "Choices": {
          "1": {
