    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID48",
      "SecondaryAttribute": "Q21-bge-m3__bge-reranker-v2-m3-chunk_2127cecc05d1ff10c4edfe90",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>1.2 incitement and encouragement of harm</strong> – Encouragement, justification, or normalization of causing harm to women or gendered subjects.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: A3.5. Online gender-based hate speech: common components at national level\n\n() Both legal and statistical definitions have been taken into account.\n\n(92) Relevant type of conduct includes inciting/instigating hatred, violence or discrimination; preaching discrimination, violence or hatred; stimulating, causing, inducing or inciting acts or activities that may lead to discrimination, hatred or violence; displaying racism, homophobia, xenophobia, anti-religious prejudice; instigating the suppression of the rights and freedoms of an organisation’s members; violating her/his dignity because of the crime’s degrading or humiliating nature; creating an intimidating, hostile or offensive situation for her/him; denying or grossly trivialising crimes of genocide, war or against peace and humanity; glorifying or justifying crimes.</div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q21-bge-m3__bge-reranker-v2-m3-chunk_2127cecc05d1ff10c4edfe90",
        "QuestionID": "QID48",
