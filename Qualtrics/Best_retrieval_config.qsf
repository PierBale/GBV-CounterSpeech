      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>3.1 casual use of gendered slurs, profanities, and insults</strong> – Casual or normalized use of gendered slurs, profanity, and insults.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: A3.5. Online gender-based hate speech: common components at national level\n\n</div><table>\n<thead>\n<tr><th colspan=\"9\">ONLINE GENDER-BASED HATE SPEECH</th></tr>\n<tr><th></th><th colspan=\"3\">TYPE OF CONDUCT</th><th colspan=\"5\">VARIABLES</th></tr>\n<tr><th>Member State</th><th>Incitement to violence, hatred, discrimination, commission of crime (<sup>92</sup>)</th><th>Calumny, defamation, insults (<sup>93</sup>)</th><th>Sexism (<sup>94</sup>)</th><th>By ICT means, any other means or in public</th><th>Gender (on grounds of gender)</th><th>Repeated over time</th><th>Intentional act (<sup>95</sup>)</th><th>Effects on victim (harm the victim) (<sup>96</sup>)</th></tr>\n</thead>\n<tbody>\n<tr><td>Belgium</td><td></td><td>X</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Bulgaria</td><td>X</td><td></td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Czechia</td><td>X</td><td>X</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Denmark</td><td>X</td><td>X</td><td></td><td></td><td></td><td></td><td>X</td><td></td></tr>\n<tr><td>Germany</td><td></td><td>X</td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Estonia</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td>X</td></tr>\n<tr><td>Ireland</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td>X</td><td>X</td></tr>\n<tr><td>Greece</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td>X</td><td>X</td></tr>\n<tr><td>Spain</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>France</td><td></td><td></td><td>X</td><td></td><td></td><td></td><td></td><td>X</td></tr>\n<tr><td>Croatia</td><td></td><td>X</td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Italy ()</td><td></td><td>X</td><td></td><td></td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Cyprus</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td>X</td><td></td></tr>\n<tr><td>Latvia</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td>X</td></tr>\n<tr><td>Lithuania</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>Luxembourg</td><td>X</td><td></td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Hungary</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td>X</td></tr>\n<tr><td>Malta ()</td><td>X</td><td></td><td></td><td></td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>Netherlands ()</td><td>X</td><td>X</td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Austria</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>Poland</td><td></td><td>X</td><td></td><td>X</td><td></td><td></td><td></td><td>X</td></tr>\n<tr><td>Portugal</td><td>X</td><td></td><td></td><td>X</td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>Romania</td><td>X</td><td></td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Slovenia</td><td>X</td><td></td><td></td><td></td><td>X</td><td></td><td></td><td></td></tr>\n<tr><td>Slovakia</td><td></td><td>X</td><td></td><td></td><td></td><td></td><td>X</td><td>X</td></tr>\n<tr><td>Finland</td><td>X</td><td></td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n<tr><td>Sweden</td><td>X</td><td>X</td><td></td><td>X</td><td></td><td></td><td></td><td></td></tr>\n</tbody>\n</table><br>",
