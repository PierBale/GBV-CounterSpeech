    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID147",
      "SecondaryAttribute": "Q130-bge-m3__qwen3-reranker-8b-chunk_cc0de56e50ab23e527323533",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>4.2 supporting systemic discrimination against women as a group</strong> – Support for systemic discrimination, restriction of rights, or exclusion of women as a group.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 4. Towards common definitions of cyber violence against women and girls > Proposed definition\n\nThe following proposed definition is based on the analysis of the key components of national-level definitions. The box below lists the core components of online gender-based hate speech and the number of Member States mentioning these in their own definitions.\nMost frequently recurring types of conduct:\n\nInciting discrimination, hostility or violence: 19 Member States <sup>(50)</sup>\n\nCondoning, denying or trivialising international crimes: 10 Member States <sup>(51)</sup>\n\nSexism: 2 Member States <sup>(52)</sup></div><br>",
        "DefaultChoices": false,
        "DataExportTag": "Q130-bge-m3__qwen3-reranker-8b-chunk_cc0de56e50ab23e527323533",
        "QuestionID": "QID147",
