    {
      "SurveyID": "SV_3C4qiwbWK4gkg06",
      "Element": "SQ",
      "PrimaryAttribute": "QID65",
      "SecondaryAttribute": "Q41-bge-m3__bge-reranker-v2-m3-chunk_df2288a86f3f8a0a56e4e0aa",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>2.2 aggressive and emotive attacks</strong> – Aggressive, degrading, or emotionally hostile insults against women, feminists, or gendered subjects.</p><br><p><strong>Paragraph</strong></p><div style=\"white-space: pre-wrap\">Section: 2. Online experiences of gender-based harassment\n\nPERCENTAGE OF GIRLS AND YOUNG WOMEN FACING DIFFERENT TYPES OF HARASSMENT\n\n</div><table>\n  <thead>\n    <tr>\n        <th>Type of Harassment</th>\n        <th>Percentage</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n        <td>Racist comments</td>\n<td>29</td>\n    </tr>\n<tr>\n        <td>Stalking</td>\n<td>32</td>\n    </tr>\n<tr>\n        <td>Body shaming</td>\n<td>39</td>\n    </tr>\n<tr>\n        <td>Threats of physical violence</td>\n<td>21</td>\n    </tr>\n<tr>\n        <td>Abusive and insulting language</td>\n<td>59</td>\n    </tr>\n<tr>\n        <td>Threats of sexual violence</td>\n<td>39</td>\n    </tr>\n<tr>\n        <td>Purposeful embarrassment</td>\n<td>41</td>\n    </tr>\n<tr>\n        <td>Sexual harassment</td>\n<td>37</td>\n    </tr>\n<tr>\n        <td>Anti LGBTIQ+ Comments</td>\n<td>26</td>\n    </tr>\n  </tbody>\n</table><br>",
        "DefaultChoices": false,
