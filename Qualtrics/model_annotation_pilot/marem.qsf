    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID79",
      "SecondaryAttribute": "answer_relevance_card_110382a05eebc8b37089d529__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>2.3 dehumanising attacks and overt sexual objectification – Derogating women by comparing them to non-human entities such as vermin, disease or refuse, or overtly reducing them to sexual objects.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Sexist hate speech includes expressions that spread, incite, promote or justify hatred based on sex. Posting and sharing violent content can involve portraying women as sexual objects or as targets of violence. Sexist and insulting comments are used to abuse women for expressing their own views and for turning away sexual advances.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "answer_relevance_card_110382a05eebc8b37089d529__deepseek_deepseek-v4_1-flash-1017",
