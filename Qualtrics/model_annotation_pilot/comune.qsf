      "Payload": {
        "QuestionText": "<h2>Task description</h2><br><br>Your task is to assess whether the generated argument is relevant, supported by the paragraph, and consistent with the EDOS label it refers to.&nbsp;<br><br>For each example, you will be asked to reply to three questions about:&nbsp;<br>- <strong>Faithfulness</strong>: if the argument is supported by the paragraph, and can be inferred by it without additional information.&nbsp;<br>- <strong>Answer Relevance</strong>: if the argument is coherent with the EDOS label.&nbsp;",
        "DefaultChoices": false,
        "DataExportTag": "Task_description",
