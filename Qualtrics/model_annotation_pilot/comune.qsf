        },
        "QuestionDescription": "faithfulness_card_ff7874374b5a86fe7bfdbe1c__deepseek_deepseek-v4_1-flash-1017",
        "Choices": {
          "1": {
            "Display": "0 - Not relevant"
          },
          "2": {
            "Display": "1 - Partially relevant"
          },
          "3": {
            "Display": "2 - Relevant"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
