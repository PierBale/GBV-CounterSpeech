    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID48",
      "SecondaryAttribute": "answer_relevance_card_44e2e87c96ccdb719e01f02a__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>1.1 threats of harm – Expressing intent, willingness or desire to harm an individual woman or group of women. This could include, but is not limited to: physical, sexual, emotional or privacy-based forms of harm.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Coordinated online mobs target women with credible rape and death threats and often extend the targeting into real life, which increases the threats’ credibility. Such campaigns cross multiple platforms, occur at high intensity and frequency, and persist for prolonged periods through many attackers acting in a concerted or coordinated way. Violent mobs threaten and target women with sexual violence, especially women with intersecting vulnerabilities, and crowds can destroy women’s privacy.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "answer_relevance_card_44e2e87c96ccdb719e01f02a__deepseek_deepseek-v4_1-flash-1017",
