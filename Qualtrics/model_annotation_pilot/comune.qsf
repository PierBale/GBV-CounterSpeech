          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "faithfulness_card_8018e0ff7b26925ad9e5d8ca__openai_gpt-6_1-sol",
        "Choices": {
