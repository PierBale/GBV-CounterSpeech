    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID155",
      "SecondaryAttribute": "faithfulness_card_4959d4ee8ae889ca27e6d327__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<strong>Paragraph</strong><br><div style=\"white-space: pre-wrap\">Appendix to Recommendation CM/Rec(2019)1 &gt; Guidelines for preventing and combating sexism: measures for implementation &gt; Definition\n\nFor the purpose of this Recommendation, sexism is:\n\nAny act, gesture, visual representation, spoken or written words, practice or behaviour based upon the idea that a person or a group of persons is inferior because of their sex, which occurs in the public or private sphere, whether online or offline, with the purpose or effect of:\n\ni. violating the inherent dignity or rights of a person or a group of persons; or\nii. resulting in physical, sexual, psychological or socio-economic harm or suffering to a person or a group of persons; or\niii. creating an intimidating, hostile, degrading, humiliating or offensive environment; or\niv. constituting a barrier to the autonomy and full realisation of human rights by a person or a group of persons; or\nv. maintaining and reinforcing gender stereotypes.</div><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Sexism is defined as any act, gesture, visual representation, spoken or written words, practice or behaviour based on the idea that a person or group is inferior because of their sex, occurring in public or private life, online or offline. It is sexist when it has the purpose or effect of violating inherent dignity or rights, causing physical, sexual, psychological or socio-economic harm or suffering, creating an intimidating, hostile, degrading, humiliating or offensive environment, constituting a barrier to autonomy and the full realisation of human rights, or maintaining and reinforcing gender stereotypes.</div><br><strong>How relevant is the argument to the paragraph?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "faithfulness_card_4959d4ee8ae889ca27e6d327__deepseek_deepseek-v4_1-flash-1017",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "faithfulness_card_4959d4ee8ae889ca27e6d327__deepseek_deepseek-v4_1-flash-1017",
        "Choices": {
          "1": {
            "Display": "0 - Not relevant"
          },
          "2": {
            "Display": "1 - Partially relevant"
          },
          "3": {
            "Display": "2 - Relevant"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
