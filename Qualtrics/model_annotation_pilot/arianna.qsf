    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID34",
      "SecondaryAttribute": "faithfulness_card_08b6565df5a66d14b526493e__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<strong>Paragraph</strong><br><div style=\"white-space: pre-wrap\">Digital Threats: The Landscape of TFGBV &gt; Targeted Violence against Influential Women\n\nHuman Rights Activists. Women human rights activists are also among those most vulnerable to online threats. Speaking as the UN Commissioner for Human Rights, Zeid Ra’ad Al Hussein highlighted how online tactics are used to “torment and terrorize women who speak out” against injustice, including the Human Rights Council’s own rapporteurs. Measuring the prevalence of TFGBV against human rights activists is extremely difficult, but there are accounts of the violence they face. A study of cyberviolence in Albania found that 83 percent of women human rights defenders had experienced a violation of their digital rights and faced daily\nthreats and harassment. Xheni Karaj, an Albanian LGBTQ+ rights activist, shared an example of the type of violent comments she receives daily: “You should tie her hands and feet with rope and pull apart with two cars, splitting her in two.”</div><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Women human rights activists are among those most vulnerable to online threats. Online tactics are used to torment and terrorize women who speak out against injustice, and activists face daily threats and harassment. These threats can include graphic descriptions of physical violence, such as tying a woman’s hands and feet with rope and pulling her apart with cars, illustrating a pattern of violent intimidation aimed at women who are publicly active.</div><br><strong>How relevant is the argument to the paragraph?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "faithfulness_card_08b6565df5a66d14b526493e__deepseek_deepseek-v4_1-flash-1017",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "faithfulness_card_08b6565df5a66d14b526493e__deepseek_deepseek-v4_1-flash-1017",
        "Choices": {
          "1": {
            "Display": "0 - Not relevant"
          },
          "2": {
            "Display": "1 - Partially relevant"
          },
          "3": {
            "Display": "2 - Relevant"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID34"
      }
    },
    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID35",
      "SecondaryAttribute": "answer_relevance_card_08b6565df5a66d14b526493e__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>1.1 threats of harm – Expressing intent, willingness or desire to harm an individual woman or group of women. This could include, but is not limited to: physical, sexual, emotional or privacy-based forms of harm.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Women human rights activists are among those most vulnerable to online threats. Online tactics are used to torment and terrorize women who speak out against injustice, and activists face daily threats and harassment. These threats can include graphic descriptions of physical violence, such as tying a woman’s hands and feet with rope and pulling her apart with cars, illustrating a pattern of violent intimidation aimed at women who are publicly active.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "answer_relevance_card_08b6565df5a66d14b526493e__deepseek_deepseek-v4_1-flash-1017",
        "QuestionType": "MC",
