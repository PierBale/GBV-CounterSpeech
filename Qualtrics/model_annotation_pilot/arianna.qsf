      }
    },
    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID67",
      "SecondaryAttribute": "answer_relevance_card_3eb03903623a0864030cdb03__deepseek_deepseek-v4_1-flash-1017",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>2.2 aggressive and emotive attacks – Expressing strong negative sentiment against women, such as disgust or hatred. This can be through direct description of the speaker’s subjective emotions, baseless accusations, or the use of gendered slurs, gender-based profanities and gender-based insults.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Hate speech can target women specifically because of their gender. Online hate reinforces systemic inequalities and makes it difficult for targeted groups to engage online. Such hate can spill over into the physical world, causing violence and even death.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
