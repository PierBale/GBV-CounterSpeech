        },
        "QuestionDescription": "faithfulness_card_84876c3cb8260436bd071fb6__deepseek_deepseek-v4_1-flash-1017",
        "Choices": {
          "1": {
            "Display": "0 - Not relevant"
          },
          "2": {
            "Display": "1 - Partially relevant"
          },
          "3": {
            "Display": "2 - Relevant"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
