ORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"31","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"RS","PrimaryAttribute":"RS_9Nse4QQa04YzQ2O","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"true","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DisplayMessage","Header":"","Footer":"","ProgressBarDisplay":"NoText","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"Sondaggio Qualtrics | Qualtrics Experience Management","SkinLibrary":"qualtricsxmc289rjt2g","SkinType":"component","Skin":{"brandingId":null,"templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"La modalit\u00e0 pi\u00f9 semplice, affidabile ed efficace per raccogliere i dati delle esperienze. Scopri Experience Management e prova subito un account gratuito.","EOSMessage":"MS_PlCZEYPgLRn8HSX","ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":"UR_w7uTTEGDaAHtEYN","EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"IT":[]}}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Carefully read the proposed texts and then answer the question.","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Carefully read the proposed texts and then answer the question.<\/h2>","DefaultChoices":false,"DataExportTag":"Instruction","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Carefully read the proposed texts and then answer the question.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"Paragraph\u00a0 Experts assess that 70 percent of young men today have been exposed to manosphere cont..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Paragraph<\/strong>&nbsp;<br>\n\nExperts assess that 70 percent of young men today have been exposed to manosphere content, and the prominence and popularity of extreme language about women normalizes everyday forms of violence and abuse. Increased normalization of extreme misogyny is also problematic because it facilitates recruitment for far-right groups that rely on sexism to draw in and mobilize new members.&nbsp;<br><br>\n\n<strong>Argument<\/strong> \n<br>\nOnline misogyny perpetrated by antifeminist groups known as 'the manosphere' has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence and abuse against women, normalizing extreme misogyny. Such normalisation facilitates recruitment for far-right groups that advocate for rollbacks of women\\'92s rights, relying on sexism to mobilize new members.<br><br>\n\n<strong>How relevant is the argument to the paragraph?<\/strong>","DefaultChoices":false,"DataExportTag":"Faithfulness","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Paragraph\u00a0 Experts assess that 70 percent of young men today have been exposed to manosphere cont...","Choices":{"1":{"Display":"0 - Not relevant"},"2":{"Display":"1 - Partially relevant"},"3":{"Display":"2 - Relevant"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"EDOS Label\u00a0 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support.","TertiaryAttribute":null,"Payload":{"QuestionText":"<hr>\n<br>\n<br>\n<strong>EDOS Label<\/strong>&nbsp;\n<br>\n4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support for systemic discrimination of women as a group. Support can be shown by denying, understating, or seeking to justify such discrimination.&nbsp;\n<br>\n<br>\n<strong>Argument<\/strong>&nbsp;\n<br>\nOnline misogyny perpetrated by antifeminist groups known as 'the manosphere' has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence and abuse against women, normalizing extreme misogyny. Such normalisation facilitates recruitment for far-right groups that advocate for rollbacks of women\\'92s rights, relying on sexism to mobilize new members.\n<br>\n<br>\n<strong>How relevant is the argument to the description of the EDOS label?<\/strong>","DefaultChoices":false,"DataExportTag":"Answer relevance","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"EDOS Label\u00a0 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support...","Choices":{"1":{"Display":"0 - Not relevant"},"2":{"Display":"1 - Partially relevant"},"3":{"Display":"2 - Relevant"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID31"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"If you have any additional comments or reflections, please use this space to share them.","TertiaryAttribute":null,"Payload":{"QuestionText":"If you have any additional comments or reflections, please use this space to share them.","DefaultChoices":false,"DataExportTag":"E1.1","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you have any additional comments or reflections, please use this space to share them.","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID4"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Task description Your task is to assess whether the generated argument is relevant, supported by...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Task description<\/h2><br><br>Your task is to assess whether the generated argument is relevant, supported by the paragraph, and consistent with the EDOS label it refers to.&nbsp;<br><br>For each example, you will be asked to reply to three questions about:&nbsp;<br>- <strong>Faithfulness<\/strong>: if the argument is supported by the paragraph, and can be inferred by it without additional information.&nbsp;<br>- <strong>Answer Relevance<\/strong>: if the argument is coherent with the EDOS label.&nbsp;","DefaultChoices":false,"DataExportTag":"Task description","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Task description Your task is to assess whether the generated argument is relevant, supported by...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_9Kzg3KA9F3QnEFM","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}