    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID126",
      "SecondaryAttribute": "faithfulness_card_14e0e4359d932982636c3530__openai_gpt-6_1-sol",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<strong>Paragraph</strong><br><div style=\"white-space: pre-wrap\">Appendix to Recommendation CM/Rec(2019)1 &gt; Guidelines for preventing and combating sexism: measures for implementation &gt; Definition\n\nFor the purpose of this Recommendation, sexism is:\n\nAny act, gesture, visual representation, spoken or written words, practice or behaviour based upon the idea that a person or a group of persons is inferior because of their sex, which occurs in the public or private sphere, whether online or offline, with the purpose or effect of:\n\ni. violating the inherent dignity or rights of a person or a group of persons; or\nii. resulting in physical, sexual, psychological or socio-economic harm or suffering to a person or a group of persons; or\niii. creating an intimidating, hostile, degrading, humiliating or offensive environment; or\niv. constituting a barrier to the autonomy and full realisation of human rights by a person or a group of persons; or\nv. maintaining and reinforcing gender stereotypes.</div><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Sexism includes spoken or written words and behaviour based on the idea that a person is inferior because of their sex, whether online or offline, in public or private. Such conduct can violate dignity or rights, cause psychological or socio-economic harm, create a degrading or humiliating environment, obstruct autonomy, or maintain and reinforce gender stereotypes.</div><br><strong>How relevant is the argument to the paragraph?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "faithfulness_card_14e0e4359d932982636c3530__openai_gpt-6_1-sol",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "faithfulness_card_14e0e4359d932982636c3530__openai_gpt-6_1-sol",
