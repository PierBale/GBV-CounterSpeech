    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID79",
      "SecondaryAttribute": "answer_relevance_card_96d8245f30a6ac1a997c4b49__openai_gpt-6_1-sol",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>2.3 dehumanising attacks and overt sexual objectification – Derogating women by comparing them to non-human entities such as vermin, disease or refuse, or overtly reducing them to sexual objects.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Online gender-based hate speech can involve posting and sharing violent content through digital technologies that portrays women and girls as sexual objects or targets of violence. Such content can be sent privately or publicly and is often targeted at women in public-facing roles. Gender-based hate speech can target women and girls because of gender alone or in combination with factors such as race, sexuality, disability or profession.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "answer_relevance_card_96d8245f30a6ac1a997c4b49__openai_gpt-6_1-sol",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
