        "NextChoiceId": 4,
        "NextAnswerId": 1,
        "QuestionID": "QID130"
      }
    },
    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID131",
      "SecondaryAttribute": "answer_relevance_card_53d8ebbd1964c3ca5aeb5c5b__openai_gpt-6_1-sol",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<hr><br><strong>EDOS Label</strong><br><p>4.1 supporting mistreatment of individual women – Expressing support for mistreatment of women as individuals. Support can be shown by denying, understating, or seeking to justify such mistreatment.</p><br><strong>Argument</strong><br><div style=\"white-space: pre-wrap\">Sexism and sexist behaviour occur across human activity, including the internet and social media, and can be experienced individually even without direct targeting. Sexism has a silencing effect when people refrain from reporting or complaining about sexist behaviour because they fear not being taken seriously, being ostracised, or being held responsible.</div><br><strong>How relevant is the argument to the description of the EDOS label?</strong>",
        "DefaultChoices": false,
        "DataExportTag": "answer_relevance_card_53d8ebbd1964c3ca5aeb5c5b__openai_gpt-6_1-sol",
