    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID32",
      "SecondaryAttribute": "Task_description",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h2>Task description</h2><br><br>Your task is to assess whether the generated argument is relevant, supported by the paragraph, and consistent with the EDOS label it refers to.&nbsp;<br><br>For each example, you will be asked to reply to three questions about:&nbsp;<br>- <strong>Faithfulness</strong>: if the argument is supported by the paragraph, and can be inferred by it without additional information.&nbsp;<br>- <strong>Answer Relevance</strong>: if the argument is coherent with the EDOS label.&nbsp;",
        "DefaultChoices": false,
        "DataExportTag": "Task_description",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Task_description",
        "ChoiceOrder": [],
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "GradingData": [],
        "Language": [],
        "NextChoiceId": 9,
        "NextAnswerId": 1,
        "QuestionID": "QID32"
      }
    },
    {
      "SurveyID": "SV_9Kzg3KA9F3QnEFM",
      "Element": "SQ",
      "PrimaryAttribute": "QID33",
      "SecondaryAttribute": "Instruction_card_ba8c2c734f5c675bbb5a5956__openai_gpt-6_1-sol",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<h2>Carefully read the proposed texts and then answer the question.</h2>",
        "DefaultChoices": false,
        "DataExportTag": "Instruction_card_ba8c2c734f5c675bbb5a5956__openai_gpt-6_1-sol",
        "QuestionType": "DB",
        "Selector": "TB",
        "DataVisibility": {
