    {
      "SurveyID": "SV_1X34YGdTiaOe2G2",
      "Element": "SQ",
      "PrimaryAttribute": "QID82",
      "SecondaryAttribute": "Q0399020b9d5b40e3-chunk_854d101ecfec0702fae859a0",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>4.1 supporting mistreatment of individual women</strong> – Expressing support for mistreatment of women as individuals. Support can be shown by denying, understating, or seeking to justify such mistreatment.</p><br><p><strong>Paragraph</strong></p>Recommendations &gt; PRINCIPLES OF A WOMEN’S SHELTER<br><br><div style=\"white-space: pre-wrap\">Shelters provide crisis intervention and ongoing support, including counselling, legal and practical assistance, housing and employment advice, and help throughout legal procedures. Support must be offered by trained female counsellors who understand the gendered dynamics of violence and believe women’s stories without prejudice. Women are seen as experts in their own situations, and counselling focuses on empowerment rather than pathology.\n\nShelters are also communal spaces, offering an environment where women and children can experience new, non-violent ways of living and relating. They serve as models of equality and shared responsibility, helping women overcome internalised gender stereotypes and rediscover their strength and agency.</div><br>",
        "DataExportTag": "Q0399020b9d5b40e3-chunk_854d101ecfec0702fae859a0",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
