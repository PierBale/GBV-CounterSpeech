    {
      "SurveyID": "SV_1X34YGdTiaOe2G2",
      "Element": "SQ",
      "PrimaryAttribute": "QID74",
      "SecondaryAttribute": "Q80a2b52797e4468c-chunk_ad285e76a178faf67da4cf6d",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>3.4 condescending explanations or unwelcome advice</strong> – Offering unsolicited or patronising advice to women on topics and issues they know more about (known as ‘mansplaining’).</p><br><p><strong>Paragraph</strong></p>Appendix to Recommendation CM/Rec(2019)1 &gt; Guidelines for preventing and combating sexism: measures for implementation &gt; Definition<br><br><div style=\"white-space: pre-wrap\">For the purpose of this Recommendation, sexism is:\n\nAny act, gesture, visual representation, spoken or written words, practice or behaviour based upon the idea that a person or a group of persons is inferior because of their sex, which occurs in the public or private sphere, whether online or offline, with the purpose or effect of:\n\ni. violating the inherent dignity or rights of a person or a group of persons; or\nii. resulting in physical, sexual, psychological or socio-economic harm or suffering to a person or a group of persons; or\niii. creating an intimidating, hostile, degrading, humiliating or offensive environment; or\niv. constituting a barrier to the autonomy and full realisation of human rights by a person or a group of persons; or\nv. maintaining and reinforcing gender stereotypes.</div><br>",
        "DataExportTag": "Q80a2b52797e4468c-chunk_ad285e76a178faf67da4cf6d",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
