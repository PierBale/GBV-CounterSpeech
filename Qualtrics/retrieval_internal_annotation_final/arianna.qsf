    {
      "SurveyID": "SV_1X34YGdTiaOe2G2",
      "Element": "SQ",
      "PrimaryAttribute": "QID33",
      "SecondaryAttribute": "Q2e50e001e49c82b5-chunk_4540e3e04353de1cd9861db6",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "<p><strong>EDOS Label</strong></p><p><strong>1.1 threats of harm</strong> – Expressing intent, willingness or desire to harm an individual woman or group of women. This could include, but is not limited to: physical, sexual, emotional or privacy-based forms of harm.</p><br><p><strong>Paragraph</strong></p>Services provided by women’s centres &gt; Introduction<br><br><div style=\"white-space: pre-wrap\">Sexualised violence is one of the most pervasive and harmful forms of violence against women and girls (VAWG), causing deep and lasting trauma to women and girls across Europe and beyond. It encompasses a continuum of behaviours that violate physical, psychological, and sexual integrity. It includes rape and sexual assault, coerced or unwanted sexual acts, sexual harassment, sexual exploitation, forced or non-consensual sexual touching, non-consensual image sharing, online sexual abuse, stalking with sexual intent, grooming, and child sexual abuse. It can occur in intimate relationships, within families, in workplaces and institutions, in public spaces, online, and in situations of conflict, displacement, or detention.</div><br>",
        "DataExportTag": "Q2e50e001e49c82b5-chunk_4540e3e04353de1cd9861db6",
        "QuestionType": "MC",
        "Selector": "SAVR",
        "SubSelector": "TX",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "QuestionDescription": "Q2e50e001e49c82b5-chunk_4540e3e04353de1cd9861db6",
        "Choices": {
          "1": {
            "Display": "0 - Not relevant"
          },
          "2": {
            "Display": "1 - Partially relevant"
          },
          "3": {
            "Display": "2 - Relevant"
          }
        },
        "ChoiceOrder": [
          "1",
          "2",
          "3"
        ],
        "Validation": {
          "Settings": {
            "ForceResponse": "ON",
            "ForceResponseType": "ON",
            "Type": "None"
          }
