{"SurveyEntry":{"SurveyID":"SV_3C4qiwbWK4gkg06","SurveyName":"Draft-retrieval-setting","SurveyDescription":null,"SurveyOwnerID":"UR_w7uTTEGDaAHtEYN","SurveyBrandID":"qualtricsxmc289rjt2g","DivisionID":null,"SurveyLanguage":"IT","SurveyActiveResponseSet":"RS_bJxP0cniPi7k5WS","SurveyStatus":"Inactive","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2026-10-22 06:41:29","CreatorID":"UR_w7uTTEGDaAHtEYN","LastModified":"2026-10-22 06:41:29","LastAccessed":"0000-00-00 00:00:00","LastActivated":"0000-00-00 00:00:00","Deleted":null},"SurveyElements":[{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"0":{"Type":"Default","Description":"Esempio domanda","ID":"BL_2sJcYEELoiWDTWm","BlockElements":[{"Type":"Question","QuestionID":"QID21"},{"Type":"Question","QuestionID":"QID1"},{"Type":"Question","QuestionID":"QID4"}],"Options":{"BlockLocking":"false","RandomizeQuestions":"false","BlockVisibility":"Expanded"}},"1":{"Type":"Trash","Description":"Domande eliminate nel cestino \/ inutilizzate","ID":"BL_3EEaUJYrHsRAD0q","BlockElements":[{"Type":"Question","QuestionID":"QID26"},{"Type":"Question","QuestionID":"QID19"},{"Type":"Question","QuestionID":"QID8"},{"Type":"Question","QuestionID":"QID27"},{"Type":"Question","QuestionID":"QID28"},{"Type":"Question","QuestionID":"QID14"},{"Type":"Question","QuestionID":"QID16"},{"Type":"Question","QuestionID":"QID17"},{"Type":"Question","QuestionID":"QID3"},{"Type":"Question","QuestionID":"QID23"},{"Type":"Question","QuestionID":"QID15"},{"Type":"Question","QuestionID":"QID11"},{"Type":"Question","QuestionID":"QID12"},{"Type":"Question","QuestionID":"QID13"},{"Type":"Question","QuestionID":"QID22"},{"Type":"Question","QuestionID":"QID24"},{"Type":"Question","QuestionID":"QID25"}]},"3":{"Type":"Standard","SubType":"","Description":"Pagina task","ID":"BL_eyb9CvW0vQkySXk","BlockElements":[{"Type":"Question","QuestionID":"QID7"}]}}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"FL","PrimaryAttribute":"Survey Flow","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"Flow":[{"ID":"BL_eyb9CvW0vQkySXk","Type":"Standard","FlowID":"FL_4"},{"ID":"BL_2sJcYEELoiWDTWm","Type":"Block","FlowID":"FL_2"}],"Properties":{"Count":7},"FlowID":"FL_1","Type":"Root"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"PL","PrimaryAttribute":"Preview Link","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"PreviewType":"Brand","PreviewID":"d19e2196-565c-45d9-8d02-df3e8fd5fa27"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"PROJ","PrimaryAttribute":"CORE","SecondaryAttribute":null,"TertiaryAttribute":"1.1.0","Payload":{"ProjectCategory":"CORE","SchemaVersion":"1.1.0"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"QC","PrimaryAttribute":"Survey Question Count","SecondaryAttribute":"28","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"RS","PrimaryAttribute":"RS_bJxP0cniPi7k5WS","SecondaryAttribute":"Insieme di risposte predefinito","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SCO","PrimaryAttribute":"Scoring","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"ScoringCategories":[],"ScoringCategoryGroups":[],"ScoringSummaryCategory":null,"ScoringSummaryAfterQuestions":0,"ScoringSummaryAfterSurvey":0,"DefaultScoringCategory":null,"AutoScoringCategory":null}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"true","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DisplayMessage","Header":"","Footer":"","ProgressBarDisplay":"NoText","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":"","NextButton":"","SurveyTitle":"Sondaggio Qualtrics | Qualtrics Experience Management","SkinLibrary":"qualtricsxmc289rjt2g","SkinType":"component","Skin":{"brandingId":null,"templateId":"*simple","overrides":null},"NewScoring":1,"SurveyMetaDescription":"La modalit\u00e0 pi\u00f9 semplice, affidabile ed efficace per raccogliere i dati delle esperienze. Scopri Experience Management e prova subito un account gratuito.","EOSMessage":"MS_PlCZEYPgLRn8HSX","ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"No","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":"UR_w7uTTEGDaAHtEYN","EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"IT":[]}}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"EDOS Label 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support f.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>EDOS Label<\/strong><\/p><p><strong>4.2 Supporting systemic discrimination against women as a group<\/strong> \u2013 Expressing support for systemic discrimination of women as a group. Support can be shown by denying, understating, or seeking to justify such discrimination.<\/p>\n<br>\n<p><strong>Paragraph<\/strong><\/p>\n<p>Experts assess that 70 percent of young men today have been exposed to manosphere content, and the prominence and popularity of extreme language about women normalizes everyday forms of violence and abuse. Increased normalization of extreme misogyny is also problematic because it facilitates recruitment for far-right groups that rely on sexism to draw in and mobilize new members. These groups, which hold a wide variety of racist, religious, and politically conservative beliefs, alongside misogyny, also advocate for extreme rollbacks of women's and minority rights, including criminalizing access to abortion and reproductive care, outlawing marriage for gay and lesbian couples, and imposing extreme restrictions on immigration and citizenship. The rise of extreme and everyday online misogyny holds significant implications for WPS efforts; indeed, UNSCR 2242 (a WPS resolution) explicitly recognizes the gendered dynamics of terrorism and violent extremism. Most existing efforts at the intersection of WPS and countering violent extremism (CVE) have focused on the Global South, but they must adapt to take the effects of TFGBV into account. This adaptation may include expanding existing conceptualizations of CVE to include extremism explicitly fueled by misogyny and considering how radicalization plays out in the Global North.<\/p>\n<br>","DefaultChoices":false,"DataExportTag":"Q1","QuestionID":"QID1","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"ShowStatements":true,"StartingValue":-1,"NumScalePoints":3,"MobileFirst":false},"QuestionDescription":"EDOS Label 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support f...","Choices":{"1":{"Display":"<h3>How relevant is the paragraph to the description of the EDOS label?<\/h3>"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Not relevant"},"2":{"Display":"Relevant"}},"ChoiceDataExportTags":false}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Age","TertiaryAttribute":null,"Payload":{"QuestionText":"Age","DefaultChoices":false,"DataExportTag":"Age","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Age","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID11"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Nationality","TertiaryAttribute":null,"Payload":{"QuestionText":"Nationality","DefaultChoices":false,"DataExportTag":"Nationality","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Nationality","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID12"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"Your first language","TertiaryAttribute":null,"Payload":{"QuestionText":"Your first language","DefaultChoices":false,"DataExportTag":"Language","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Your first language","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID13","DisplayLogic":{"0":{"0":{"LogicType":"BooleanValue","Value":"False","Type":"Expression","Description":"<span class=\"ConjDesc\">If<\/span><span> False<\/span>"},"Type":"If"},"Type":"BooleanExpression","inPage":false}}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"Ethnicity","TertiaryAttribute":null,"Payload":{"QuestionText":"Ethnicity","DefaultChoices":false,"DataExportTag":"Ethnicity","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Ethnicity","Choices":{"1":{"Display":"White"},"2":{"Display":"Black"},"3":{"Display":"Asian"},"4":{"Display":"Latino"},"5":{"Display":"Mixed"},"6":{"Display":"Self-assess your ethnicity","TextEntry":"true"},"7":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2,3,4,5,6,7],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID14"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Are you currently a student?","TertiaryAttribute":null,"Payload":{"QuestionText":"Are you currently a student?","DataExportTag":"Student status","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Are you currently a student?","Choices":{"1":{"Display":"Yes, in the bachelor's degree"},"2":{"Display":"Yes, in the master's degree"},"3":{"Display":"Yes, I am a PhD student"},"4":{"Display":"No"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID15"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Highest education level completed","TertiaryAttribute":null,"Payload":{"QuestionText":"Highest education level completed","DataExportTag":"Education level","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Highest education level completed","Choices":{"1":{"Display":"No formal qualifications"},"2":{"Display":"Secondary education"},"3":{"Display":"High school diploma"},"4":{"Display":"Bachelor degree"},"5":{"Display":"Master degree"},"6":{"Display":"Doctorate degree"},"7":{"Display":"Other","TextEntry":"true"},"8":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2,3,4,5,6,7,"8"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID16"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Employment status","TertiaryAttribute":null,"Payload":{"QuestionText":"Employment status","DataExportTag":"Employment","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Employment status","Choices":{"1":{"Display":"Full-time"},"2":{"Display":"Part-time"},"3":{"Display":"Due to start a new job"},"4":{"Display":"Unemployed (and job seeking)"},"5":{"Display":"Not in paid work (e.g. homemaker, retired)"},"6":{"Display":"Other","TextEntry":"true"},"7":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2,3,4,5,6,"7"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":8,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"Sociodemographic Survey","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Sociodemographic Survey<\/h2>","DefaultChoices":false,"DataExportTag":"title","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Sociodemographic Survey","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID19"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Carefully read the proposed texts and then answer the question.","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Carefully read the proposed texts and then answer the question.<\/h2>","DefaultChoices":false,"DataExportTag":"Instruction","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Carefully read the proposed texts and then answer the question.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID21"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"EDOS Label 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support f.","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>EDOS Label<\/strong><\/p><p><strong>4.2 Supporting systemic discrimination against women as a group<\/strong> \u2013 Expressing support for systemic discrimination of women as a group. Support can be shown by denying, understating, or seeking to justify such discrimination.<\/p><p><br><\/p><p>\n<strong>Paragraph<\/strong>&nbsp;<\/p><p>[...] Increased normalization of extreme misogyny is also problematic because it facilitates recruitment for far-right groups that rely on sexism to draw in and mobilize new members. [...]<br><\/p><br>\n<p><strong>Argument<\/strong><\/p>\n<p>Online misogyny perpetrated by antifeminist groups known as \u201cthe manosphere\u201d has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence...<\/p>\n<br>\n<hr>","DefaultChoices":false,"DataExportTag":"All","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"MobileFirst":false,"ShowStatements":true,"StartingValue":-1,"NumScalePoints":3},"QuestionDescription":"EDOS Label 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support f...","Choices":{"1":{"Display":"<h3>How relevant is the paragraph to the description of the EDOS label?<\/h3>"},"2":{"Display":"<h3>How relevant is the argument to the description of the EDOS label?<\/h3>"},"3":{"Display":"<h3>Howe relevant is the argument to the paragraph?<\/h3>"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Non rilevante"},"2":{"Display":"Rilevante"}},"ChoiceDataExportTags":false,"QuestionID":"QID22"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"Paragraph [...] Increased normalization of extreme misogyny is also problematic because it facili...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Paragraph<\/strong><\/p>\n<p>[...] Increased normalization of extreme misogyny is also problematic because it facilitates recruitment for far-right groups that rely on sexism to draw in and mobilize new members. [...]<\/p>\n<br>\n<p><strong>Argument<\/strong><\/p>\n<p>Online misogyny perpetrated by antifeminist groups known as \u201cthe manosphere\u201d has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence...<\/p>\n<br>\n<hr>","DefaultChoices":false,"DataExportTag":"Answer Relevance","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"MobileFirst":false,"ShowStatements":true,"StartingValue":-1,"NumScalePoints":3},"QuestionDescription":"Paragraph [...] Increased normalization of extreme misogyny is also problematic because it facili...","Choices":{"1":{"Display":"<h3>How relevant is the paragraph to the description of the EDOS label?<\/h3>"},"2":{"Display":"<h3>How relevant is the argument to the description of the EDOS label?<\/h3>"},"3":{"Display":"<h3>Howe relevant is the argument to the paragraph?<\/h3>"}},"ChoiceOrder":[1,2,3],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":3,"Labels":{"1":{"Display":"Non rilevante"},"2":{"Display":"Rilevante"}},"ChoiceDataExportTags":false,"QuestionID":"QID23"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"EDOS Label\u00a0 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support.","TertiaryAttribute":null,"Payload":{"QuestionText":"<hr>\n<br>\n<strong>EDOS Label<\/strong>&nbsp;<br>4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support for systemic discrimination of women as a group. Support can be shown by denying, understating, or seeking to justify such discrimination.&nbsp;<br><br><strong>Argument<\/strong>&nbsp;<br>Online misogyny perpetrated by antifeminist groups known as 'the manosphere' has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence and abuse against women, normalizing extreme misogyny. Such normalisation facilitates recruitment for far-right groups that advocate for rollbacks of women\\'92s rights, relying on sexism to mobilize new members.\n<br>","DefaultChoices":false,"DataExportTag":"Q2","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"MobileFirst":false,"ShowStatements":true,"StartingValue":-1,"NumScalePoints":3},"QuestionDescription":"EDOS Label\u00a0 4.2 Supporting systemic discrimination against women as a group \u2013 Expressing support...","Choices":{"1":{"Display":"<h3>How relevant is the argument to the description of the EDOS label?<\/h3>"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Not relevant"},"2":{"Display":"Relevant"}},"ChoiceDataExportTags":false,"QuestionID":"QID24"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Paragraph Experts assess that 70 percent of young men today have been exposed to manosphere conte...","TertiaryAttribute":null,"Payload":{"QuestionText":"<hr>\n<br>\n<p><strong>Paragraph<\/strong><\/p>\n<p>Experts assess that 70 percent of young men today have been exposed to manosphere content, and the prominence and popularity of extreme language about women normalizes everyday forms of violence and abuse. Increased normalization of extreme misogyny is also problematic because it facilitates recruitment for far-right groups that rely on sexism to draw in and mobilize new members. These groups, which hold a wide variety of racist, religious, and politically conservative beliefs, alongside misogyny, also advocate for extreme rollbacks of women's and minority rights, including criminalizing access to abortion and reproductive care, outlawing marriage for gay and lesbian couples, and imposing extreme restrictions on immigration and citizenship. The rise of extreme and everyday online misogyny holds significant implications for WPS efforts; indeed, UNSCR 2242 (a WPS resolution) explicitly recognizes the gendered dynamics of terrorism and violent extremism. Most existing efforts at the intersection of WPS and countering violent extremism (CVE) have focused on the Global South, but they must adapt to take the effects of TFGBV into account. This adaptation may include expanding existing conceptualizations of CVE to include extremism explicitly fueled by misogyny and considering how radicalization plays out in the Global North.<br><br><strong>Argument<\/strong>&nbsp;<\/p><p>Online misogyny perpetrated by antifeminist groups known as 'the manosphere' has a direct impact on real-life systemic discrimination against women. In these forums, men explicitly support violence and abuse against women, normalizing extreme misogyny. Such normalisation facilitates recruitment for far-right groups that advocate for rollbacks of women\\'92s rights, relying on sexism to mobilize new members.\n<br><\/p>\n<br>","DefaultChoices":false,"DataExportTag":"Q3","QuestionType":"Slider","Selector":"NumberScale","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","ShowValue":true,"MobileFirst":false,"ShowStatements":true,"StartingValue":-1,"NumScalePoints":3},"QuestionDescription":"Paragraph Experts assess that 70 percent of young men today have been exposed to manosphere conte...","Choices":{"1":{"Display":"<h3>How relevant is the argument to the paragraph?<\/h3>"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"OFF","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Not relevant"},"2":{"Display":"Relevant"}},"ChoiceDataExportTags":false,"QuestionID":"QID25"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"The annotation task is completed! If you want to leave us any comment about it, please use this s...","TertiaryAttribute":null,"Payload":{"QuestionText":"The annotation task is completed! If you want to leave us any comment about it, please use this space.&nbsp;","DefaultChoices":false,"DataExportTag":"Q19","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The annotation task is completed! If you want to leave us any comment about it, please use this s...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID26"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Age","TertiaryAttribute":null,"Payload":{"QuestionText":"Age","DefaultChoices":false,"DataExportTag":"Age","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Age","Choices":{"1":{"Display":"Write your age","TextEntry":"true"},"2":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID27"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"Nationality","TertiaryAttribute":null,"Payload":{"QuestionText":"Nationality","DefaultChoices":false,"DataExportTag":"Nationality","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Nationality","Choices":{"1":{"Display":"Write your Nationality","TextEntry":"true"},"2":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID28"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Welcome and thank you for the participation! Thanks for your interest in this study. Our aim is t...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Welcome and thank you for the participation!<\/h2>\n\n<p><br><\/p>Thanks for your interest in this study.<br><br>Our aim is to build a system for countering online hate speech. In this phase, you will first be asked to provide some <strong>sociodemographic information<\/strong>. Then, you will be presented with a series of questions to <strong>evaluate the consistency of automatically generated arguments<\/strong> in relation to short text excerpts and predefined categories of sexist or misogynistic language.<br><br>The task will be conducted entirely in <strong>English<\/strong> and will primarily require reading comprehension skills, with an upper-Intermediate level of language proficiency.<br>The duration is of approximately [xxx] hours. <br><br><strong>Your participation in this survey is voluntary<\/strong>; feel free to quit at any time without giving a reason. &nbsp;<br><br>The data we collect will be used for research purposes. It will be made publicly available in an anonymised form. We will further write a scientific publication about this study which can include examples from the collected data (also in anonymous form).&nbsp;<br><br><br>Responsible and contact person: Marta Marchiori Manerba<br>For any information, contact us at: marta.marchiorimanerba@unito.it ","DefaultChoices":false,"DataExportTag":"Spiegazione","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome and thank you for the participation! Thanks for your interest in this study. Our aim is t...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID4","SecondaryAttribute":"If you have any additional comments or reflections, please use this space to share them.","TertiaryAttribute":null,"Payload":{"QuestionText":"If you have any additional comments or reflections, please use this space to share them.","DefaultChoices":false,"DataExportTag":"E1.1","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"If you have any additional comments or reflections, please use this space to share them.","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID4"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Task description In this task, you will be shown a label from the EDOS taxonomy and a short parag...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2>Task description<\/h2>\n\n<br>In this task, you will be shown a label from the EDOS taxonomy and a short paragraph taken from a report.<br><br>Your task is to assess the&nbsp;<strong>Context Relevance<\/strong>, i.e., if the paragraph contains information that is needed to answer to the harm defined by the EDOS label.","DefaultChoices":false,"DataExportTag":"Task description","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Task description In this task, you will be shown a label from the EDOS taxonomy and a short parag...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID7"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Gender identity","TertiaryAttribute":null,"Payload":{"QuestionText":"Gender identity","DefaultChoices":false,"DataExportTag":"Gender","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Gender identity","Choices":{"1":{"Display":"Male"},"2":{"Display":"Female"},"3":{"Display":"Non-binary"},"4":{"Display":"Self-assess your identity","TextEntry":"true"},"5":{"Display":"Prefer not to say"}},"ChoiceOrder":[1,2,3,4,5],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID8"}},{"SurveyID":"SV_3C4qiwbWK4gkg06","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":false,"ID":"Survey Statistics"}}]}