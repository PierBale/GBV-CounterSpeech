{
  "pdf_dir": "documents",
  "markdown_dir": "src/1_parsed_results",
  "output_dir": "data/card_creation",
  "labels_path": "src/unito_amazon/card_creation/edos_labels.json",
  "llama_api_key_env": "LLAMA_CLOUD_API_KEY",
  "llama_base_url": "https://api.cloud.eu.llamaindex.ai",
  "llama_tier": "agentic",
  "llama_version": "2026-09-13",
  "min_chunk_tokens": 100,
  "editorial_filter_enabled": true,
  "include_section_titles": true,
  "long_chunk_warning_tokens": 2000,
  "embedding_model": "Qwen/Qwen3-Embedding-4B",
  "embedding_batch_size": 4,
  "embedding_max_tokens": 32768,
  "dense_top_j": 100,
  "reranker_model": "Qwen/Qwen3-Reranker-4B",
  "reranker_batch_size": 4,
  "reranker_max_tokens": 32768,
  "rerank_top_k": 10,
  "deduplication_enabled": true,
  "deduplication_similarity_threshold": 0.97,
  "generator_model": "google/gemma-4-12B-it",
  "generate_evidence": true,
  "generation_max_new_tokens": 2048,
  "generation_temperature": 0.7,
  "generation_retries": 5,
  "device": null
